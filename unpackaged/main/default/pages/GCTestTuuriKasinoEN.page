<apex:page showHeader="false" sidebar="false" standardStylesheets="false" applyHtmlTag="true" applyBodyTag="true">
    <html>
    <head>
        <title>Live Chat Test</title>

        <!-- Button styling -->
        <style type="text/css">
            .embeddedServiceHelpButton .helpButton .uiButton {
                background-color: #005290;
                font-family: "Arial", sans-serif;
                font-size: 14px;
            }
            .embeddedServiceHelpButton .helpButton .uiButton:focus {
                outline: 1px solid #005290;
            }
        </style>

        <!-- Load Embedded Service script from your sandbox org -->
        <script type="text/javascript" src="https://service.force.com/embeddedservice/5.0/esw.min.js"></script>

        <script type="text/javascript">
            var initESW = function(gslbBaseURL) {
                // General settings
                embedded_svc.settings.displayHelpButton = true;
                embedded_svc.settings.language = 'en';

                // Optional text overrides
                embedded_svc.settings.defaultMinimizedText = 'Chat with us';
                embedded_svc.settings.disabledMinimizedText = 'Agents Offline';

                // Enable Live Agent feature
                embedded_svc.settings.enabledFeatures = ['LiveAgent'];
                embedded_svc.settings.entryFeature = 'LiveAgent';

                // Initialize
                embedded_svc.init(
                    'https://d200000008vasea2.my.salesforce.com',
            'https://d200000008vasea2.my.salesforce-sites.com/',
                    gslbBaseURL,
                    '00D200000008VAS', // OrgId
                    'Tuurikasino_EN_Chat', // Deployment name
                    {
                        baseLiveAgentContentURL: 'https://c.la11-core1.sfdc-5pakla.salesforceliveagent.com/content',
                        deploymentId: '572D0000000GnMY', // From Setup → Live Agent → Deployments
                        buttonId: '573P10000008r8n', // From Setup → Live Agent → Chat Buttons & Invitations
                        baseLiveAgentURL: 'https://d.la11-core1.sfdc-5pakla.salesforceliveagent.com/chat',
                        eswLiveAgentDevName: 'EmbeddedServiceLiveAgent_Parent04IP1000001QvLRMA0_1980e3f5d0a',
                        isOfflineSupportEnabled: false
                    }
                );
            };

            if (!window.embedded_svc) {
                initESW(null);
            } else {
                initESW('https://service.force.com');
            }
        </script>
    </head>

    <body>
        <h2 style="margin:20px; font-family: Arial, sans-serif;">Test Live Chat</h2>
        <p style="margin:20px; font-family: Arial, sans-serif;">
            Click the chat button in the bottom-right corner to start chatting.
        </p>
    </body>
    </html>

