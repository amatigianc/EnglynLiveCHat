    <description>searches for accounts throughout the Battlecat domains</description>
    <environments>Default</environments>
    <formulas>
        <name>BCDomains</name>
        <dataType>String</dataType>
        <expression>IF (CONTAINS({!input_Origin_Country},&#39;KUNKKU&#39;),&#39;Kunkku&#39;,
IF(CONTAINS({!input_Origin_Country},&#39;LEMPI&#39;),&#39;LEMPI-FI&#39;,
IF(CONTAINS({!input_Origin_Country},&#39;MAMMONA&#39;),&#39;Mammonakasino&#39;,
IF(CONTAINS({!input_Origin_Country},&#39;VALTI&#39;),&#39;valttikasino&#39;,
IF (CONTAINS({!input_Origin_Country},&#39;SALETTI&#39;),&#39;Saletti&#39;,
IF (CONTAINS({!input_Origin_Country},&#39;TUURI&#39;),&#39;Tuurikasino&#39;,&#39;&#39;)
)
)
)
)
)</expression>
    </formulas>
    <formulas>
        <name>Origin_Country_f</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!input_Origin_Country}, &quot;_&quot;,&quot;-&quot;)</expression>
    </formulas>
