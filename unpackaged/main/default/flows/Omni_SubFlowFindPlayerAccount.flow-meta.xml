    <formulas>
        <description>given Domain and outputCustomerTier = final originCountry Value</description>
        <name>customerFinalLevel_f</name>
        <dataType>String</dataType>
        <expression>CASE(
   {!accountDomain},  
   &quot;ANATOLIAN TU&quot;,
      CASE(
         {!outputAccountTier},
         &quot;MASS&quot;, &quot;ANADOLU_CASINO&quot;,
         &quot;PLUS&quot;, &quot;ANADOLU_PLUS&quot;,
          &quot;SPECIAL&quot;, &quot;ANADOLU_CASINO_VIP&quot;,
          &quot;ACCOUNTMANAGERS&quot;, &quot;ANADOLU_CASINO_VIP&quot;,
         &quot;VIP&quot;, &quot;ANADOLU_CASINO_VIP&quot;,
         &quot;ANADOLU_CASINO&quot;
      ),
&quot;Betboo TR&quot;,
      CASE(
          {!outputAccountTier},
         &quot;MASS&quot;, &quot;BETTRK&quot;,
         &quot;PLUS&quot;, &quot;BETTRK_PLUS&quot;,
&quot;SPECIAL&quot;, &quot;BETTRK_PLUS&quot;,
         &quot;ACCOUNTMANAGERS&quot;, &quot;BETTRK_E&amp;G&quot;,
         &quot;VIP&quot;, &quot;BETTRK_E&amp;G&quot;,
         &quot;BETBOO&quot;
      ),
   &quot;superbahis&quot;,
      CASE(
          {!outputAccountTier},
         &quot;MASS&quot;, &quot;SUPERBAHIS&quot;,
&quot;SPECIAL&quot;, &quot;SUP_PLUS&quot;,
         &quot;PLUS&quot;, &quot;SUP_PLUS&quot;,
         &quot;VIP&quot;, &quot;SUP_E&amp;G&quot;,
         &quot;ACCOUNTMANAGERS&quot;, &quot;SUP_E&amp;G&quot;,
         &quot;superbahis&quot;
      ),
   &quot;Unknown&quot;
)</expression>
    </formulas>
