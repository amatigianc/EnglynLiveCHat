    <description>It returns the BattleCat Queue based on the VIP level of the Account record</description>
    <environments>Default</environments>
    <formulas>
        <name>isBC_VIP</name>
        <dataType>Boolean</dataType>
        <expression>AND(
NOT(ISNULL({!input_BC_VIPLEVEL})),
OR(
{!input_BC_VIPLEVEL} = &#39;BCP&#39;,
{!input_BC_VIPLEVEL} = &#39;BCG&#39;,
{!input_BC_VIPLEVEL} = &#39;BCS&#39;
)
)</expression>
    </formulas>
