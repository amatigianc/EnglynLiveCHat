    <decisions>
        <name>isCorrectUser</name>
        <label>isCorrectUser</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Errror</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CEE_VIP</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$User.ProfileId</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>00e3z000001R7VE</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$User.ProfileId</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>00e3z000001orSp</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$User.ProfileId</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>00e3z000002AI76AAG</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$UserRole.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Fraud_GVC</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$UserRole.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Profibull</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>setDefaulCaseRecords</targetReference>
            </connector>
            <label>CEE VIP</label>
        </rules>
    </decisions>
    <description>It create a case for the VIP team and it assign it to a queue.</description>
    <environments>Default</environments>
    <formulas>
        <description>It transforms the Account Domain Value to Origin Country Value with an underscore</description>
        <name>AccountDomainToOriginCountry</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!getAccount.Domain__c}, &quot; &quot;, &quot;_&quot;)</expression>
    </formulas>
