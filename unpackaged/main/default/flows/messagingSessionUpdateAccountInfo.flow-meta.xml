<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>saveAccountDomain</name>
        <label>saveAccountDomain</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>accountDomain</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Player_Account__r.Domain__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>accountTier</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Player_Account__r.Customer_Tier_Code_Summary__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>getCase</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>isAccountBattlecat</name>
        <label>isAccountBattlecat</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>updateCase</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_isAccountBattlecat</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>accountDomain</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>LEMPI</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>accountDomain</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Kunkku</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>accountDomain</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Saletti</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>accountDomain</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Tuuri</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>accountDomain</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Valtti</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_updateCase</targetReference>
            </connector>
            <label>YES_isAccountBattlecat</label>
        </rules>
    </decisions>
    <description>Given a MessagingSession without PlayerAccount, once it&#39;s update, it also updates Case information.</description>
    <environments>Default</environments>
    <formulas>
        <name>TR_customerLevel</name>
        <dataType>String</dataType>
        <expression>CASE(
   {!accountDomain},  
   &quot;ANATOLIAN TU&quot;,
      CASE(
       {!accountTier},
         &quot;MASS&quot;, &quot;ANADOLU_CASINO&quot;,
         &quot;PLUS&quot;, &quot;ANADOLU_PLUS&quot;,
          &quot;SPECIAL&quot;, &quot;ANADOLU_CASINO_VIP&quot;,
          &quot;ACCOUNTMANAGERS&quot;, &quot;ANADOLU_CASINO_VIP&quot;,
         &quot;VIP&quot;, &quot;ANADOLU_CASINO_VIP&quot;,
         &quot;ANADOLU_CASINO&quot;
      ),
&quot;Betboo TR&quot;,
      CASE(
          {!accountTier},
         &quot;MASS&quot;, &quot;BETTRK&quot;,
         &quot;PLUS&quot;, &quot;BETTRK_PLUS&quot;,
&quot;SPECIAL&quot;, &quot;BETTRK_PLUS&quot;,
         &quot;ACCOUNTMANAGERS&quot;, &quot;BETTRK_E&amp;G&quot;,
         &quot;VIP&quot;, &quot;BETTRK_E&amp;G&quot;,
         &quot;BETBOO&quot;
      ),
   &quot;superbahis&quot;,
      CASE(
          {!accountTier},
         &quot;MASS&quot;, &quot;SUPERBAHIS&quot;,
&quot;SPECIAL&quot;, &quot;SUP_PLUS&quot;,
         &quot;PLUS&quot;, &quot;SUP_PLUS&quot;,
         &quot;VIP&quot;, &quot;SUP_E&amp;G&quot;,
         &quot;ACCOUNTMANAGERS&quot;, &quot;SUP_E&amp;G&quot;,
         &quot;superbahis&quot;
      ),
   &quot;Unknown&quot;
)</expression>
    </formulas>
    <interviewLabel>messagingSession {!$Flow.CurrentDateTime}</interviewLabel>
    <label>messagingSessionUpdateAccountInfo</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getCase</name>
        <label>getCase</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>isAccountBattlecat</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CaseId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Copy_1_of_updateCase</name>
        <label>Copy 1 of updateCase</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CaseId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>$Record.Player_Account__r.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Origin_Country__c</field>
            <value>
                <elementReference>$Record.Origin_Country__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Player_Account_Id__c</field>
            <value>
                <elementReference>$Record.Player_Account__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SB_Pin__c</field>
            <value>
                <elementReference>$Record.Player_Account__r.SB_User_ID__pc</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <recordUpdates>
        <name>updateCase</name>
        <label>updateCase</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CaseId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>$Record.Player_Account__r.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Origin_Country__c</field>
            <value>
                <elementReference>TR_customerLevel</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Player_Account_Id__c</field>
            <value>
                <elementReference>$Record.Player_Account__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SB_Pin__c</field>
            <value>
                <elementReference>$Record.Player_Account__r.SB_User_ID__pc</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>saveAccountDomain</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Player_Account__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Player_Account__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>MessagingSession</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
